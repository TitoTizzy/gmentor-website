---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Connexion administrateur | Marie Gaëlle Mentor" noindex>
  <div class="page-shell container" style="max-width:620px">
    <header style="margin-bottom:3rem"><p class="eyebrow">Administration</p><h1 style="font:400 clamp(3rem,8vw,6rem)/.95 var(--serif);margin:0">Connexion</h1></header>
    <form class="contact-form" data-login-form>
      <div class="field span-2"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required /></div>
      <div class="field span-2"><label for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
      <p class="form-note span-2">La double authentification est obligatoire pour tous les comptes administrateurs.</p>
      <p class="form-note span-2" role="alert" data-login-status></p>
      <div class="span-2"><button class="button button-primary" type="submit">Se connecter</button></div>
    </form>
  </div>
  <script>
    import { createClient } from '@supabase/supabase-js';
    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    const status = document.querySelector('[data-login-status]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const url = import.meta.env.PUBLIC_SUPABASE_URL;
      const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      if (!url || !key) { if (status) status.textContent = 'Mode démonstration : configurez Supabase pour activer la connexion.'; return; }
      const data = new FormData(form);
      const supabase = createClient(url, key);
      const { error } = await supabase.auth.signInWithPassword({ email: String(data.get('email')), password: String(data.get('password')) });
      if (error) { if (status) status.textContent = 'Connexion impossible. Vérifiez vos identifiants.'; return; }
      location.href = '/admin';
    });
  </script>
</BaseLayout>
