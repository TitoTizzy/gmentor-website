---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Gestion des cookies | Marie Gaëlle Mentor">
  <article class="page-shell container"><header class="page-intro"><p class="eyebrow">Cookies</p><div><h1>Vos préférences.</h1><p>Le site mémorise votre langue, votre thème et votre choix concernant les statistiques.</p></div></header><section class="band"><button class="button button-primary" type="button" data-reset-consent>Réinitialiser mes préférences</button><p data-reset-status aria-live="polite"></p></section></article>
  <script>document.querySelector('[data-reset-consent]')?.addEventListener('click',()=>{['mgm-locale','mgm-theme','mgm-analytics-consent'].forEach((key)=>localStorage.removeItem(key));const status=document.querySelector('[data-reset-status]');if(status)status.textContent='Préférences réinitialisées.';});</script>
</BaseLayout>
